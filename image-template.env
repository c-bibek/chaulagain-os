# Chaulagain OS build settings

# Name of the published OS image: ghcr.io/c-bibek/chaulagain-os
IMAGE_NAME=chaulagain-os

# GitHub account that owns the image
REPO_ORGANIZATION="c-bibek"

IMAGE_DESC="Chaulagain OS: a macOS-inspired desktop on Fedora KDE with Pixel phone integration and over-the-air updates"
IMAGE_KEYWORDS="bootc,oci,linux,fedora,kde,chaulagain-os"

IMAGE_LOGO_URL="https://github.com/c-bibek.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
